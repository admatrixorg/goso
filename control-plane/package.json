{
  "name": "@goso/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && VITE_DEMO_MODE=true vite build",
    "build:prod": "tsc --noEmit && VITE_DEMO_MODE=false vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/api/*.test.ts",
    "verify": "tsc --noEmit && vite build",
    "qa:tabs": "node --experimental-strip-types scripts/qa-tabs.ts",
    "preview": "vite preview --port 3000"
  },
  "dependencies": {
    "lucide-react": "^0.553.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "puppeteer-core": "^24.2.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.3"
  }
}
