# syntax=docker/dockerfile:1
# Omni-Core bridge image. Same binary as the gateway; starts `bridge` on 8088.
# Point it at an existing Postgres 16 database named goso. No extra services.

FROM golang:1.25-alpine AS build
WORKDIR /src
RUN apk add --no-cache ca-certificates git
COPY go.mod go.sum ./
RUN go mod download
COPY gateway ./gateway
COPY api ./api
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/goso-gateway ./gateway/cmd/goso-gateway

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata wget \
	&& adduser -D -u 1000 goso \
	&& mkdir -p /data && chown goso:goso /data
COPY --from=build /out/goso-gateway /usr/local/bin/goso-gateway
USER goso
WORKDIR /data
VOLUME /data
EXPOSE 8088
ENV GOSO_PORT=8088 \
	GOSO_HOST=0.0.0.0 \
	GOSO_ENV=production \
	GOMEMLIMIT=220MiB
HEALTHCHECK --interval=15s --timeout=3s --start-period=8s --retries=3 \
	CMD wget -qO- http://127.0.0.1:8088/healthz || exit 1
ENTRYPOINT ["goso-gateway"]
CMD ["bridge"]
