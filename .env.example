# Copy to .env (gitignored) and fill locally. Never commit real values.
# Docker compose also reads .env (compose.yml / compose.prod.yml).

GOSO_PORT=8080
GOSO_HOST=127.0.0.1
GOSO_ENV=development
GOSO_LOG_LEVEL=info

# Required for /api/* unless GOSO_DEV_MODE=1 (explicit passthrough).
GOSO_ADMIN_TOKEN=dev-local-change-me
# GOSO_VIEW_TOKEN=
# GOSO_DEV_MODE=1

# SPEC 041/066 security (defaults keep local fake e2e working).
# Production (GOSO_ENV=production): injection defaults to block, query ?token= is ignored,
# and GOSO_WS_ORIGINS is required. Demo/unset keep previous defaults.
# GOSO_INJECTION=log
# GOSO_SSRF=1
# GOSO_WORKSPACE=
# GOSO_MASTER_KEY=
# GOSO_DEV_MODE=1
# GOSO_WS_ORIGINS=

# Requests per minute per IP. 0 = off.
GOSO_RATE_LIMIT=60

# Empty or :memory: = in-memory. File path = SQLite (e.g. data/goso.db; Docker: /data/goso.db).
GOSO_DB_PATH=
# Optional local Postgres (compose profile postgres, host 5433). Unset = SQLite.
# docker compose --profile postgres up -d postgres
# GOSO_DATABASE_URL=postgres://goso:goso@127.0.0.1:5433/goso?sslmode=disable
# Connect fail is fatal (no sqlite fallback). Do not point demo :18080 at PG.
# GOSO_TEST_DATABASE_URL=   # skip-if-unset store roundtrip
# See docs/qa/085-postgres-local.md
# GOSO_MULTI_TENANT=1  # honor X-Goso-Tenant (admin token required for non-default). Unset/demo = always default.

# SPEC 070 consistent snapshots via VACUUM INTO (not cp of the live file).
# GOSO_BACKUP_DIR=./var/backups
# BACKUP_INTERVAL_SECONDS=3600
# BACKUP_RETAIN=14

# Markdown/text vault root (SPEC 037). Default: data/vault
# GOSO_VAULT_DIR=data/vault

# SPEC 038 Lite caps: max 5 agents / max 1 team.
# SPEC 055: Control-plane Channels page shows "Lite: channels off"; adapters stay listed on GET /api/channels.
# GOSO_LITE=1

# LLM (optional; empty/unset → provider absent, echo fallback). Never commit real keys.
GOSO_ANTHROPIC_API_KEY=
GOSO_ANTHROPIC_MODEL=
# Anthropic prompt cache: "full" attaches cache_control to stable prefix blocks.
# GOSO_PROMPT_CACHE=full is equivalent when GOSO_ANTHROPIC_CACHE_MODE is empty.
GOSO_ANTHROPIC_CACHE_MODE=
GOSO_PROMPT_CACHE=
GOSO_OPENAI_API_KEY=
GOSO_OPENAI_MODEL=
GOSO_OPENROUTER_API_KEY=
GOSO_GROQ_API_KEY=
GOSO_DEEPSEEK_API_KEY=
GOSO_GEMINI_API_KEY=
GOSO_MISTRAL_API_KEY=
GOSO_XAI_API_KEY=
GOSO_MINIMAX_API_KEY=
GOSO_DASHSCOPE_API_KEY=

# SPEC 044/045 local 9Router (OpenAI-compat). Construct when BASE_URL set; API key may be empty.
# Catalog default is ocg/deepseek-v4-flash; GOSO_ROUTER9_MODEL overrides (cx/* still valid).
# GOSO_ROUTER9_BASE_URL=http://127.0.0.1:20127/v1
# GOSO_ROUTER9_MODEL=ocg/deepseek-v4-flash
# GOSO_ROUTER9_API_KEY=
# GOSO_LLM_PROVIDER=router9
# GOSO_WEB_SEARCH=  # empty = web_search fail-closed; ddg or 1 = DuckDuckGo Instant Answer
# GOSO_SANDBOX_IMAGE=  # empty = sandbox not_configured; set + docker on PATH = docker run --rm --network=none --memory=256m
# GOSO_BROWSER_BIN=  # existing Chrome file (or CHROME_PATH); empty = browser not_configured
# CHROME_PATH=
# GOSO_FFMPEG=  # existing ffmpeg file; else PATH ffmpeg only when GOSO_MEDIA=1
# GOSO_MEDIA=  # empty = PATH ffmpeg off; image_gen/tts still need an injected test double (no paid API)
# GOSO_SKILLS_DIR=  # empty = use_skill + GET /api/skills fail-closed; set to a folder of <name>/SKILL.md
# GOSO_CONTEXT_DIR=  # empty = no bootstrap inject; set to a dir of SOUL.md IDENTITY.md AGENTS.md (optional USER.md)

# Channels (optional). Empty = listed on GET /api/channels with configured:false, missing:true, env_names[].
# Do not commit real values. PATCH does not store tokens. Secrets-box uses GOSO_MASTER_KEY (channel:<name>:<kind>).
GOSO_TELEGRAM_BOT_TOKEN=
# GOSO_TELEGRAM_MODE=poll
# GOSO_TELEGRAM_WEBHOOK_SECRET=
# GOSO_PUBLIC_URL=
GOSO_ZALO_OA_ACCESS_TOKEN=
GOSO_ZALO_OA_SECRET=
# GOSO_ZALO_OA_APP_ID=
GOSO_ZALO_PERSONAL_TOKEN=
GOSO_DISCORD_BOT_TOKEN=
GOSO_SLACK_BOT_TOKEN=
GOSO_SLACK_APP_TOKEN=
GOSO_FEISHU_APP_SECRET=
GOSO_WHATSAPP_ACCESS_TOKEN=
# GOSO_LIVE_TELEGRAM=
# GOSO_LIVE_ZALO_OA=
# GOSO_LIVE_ZALO_PERSONAL=
# GOSO_LIVE_CHANNELS=

# WebSocket origin allowlist (comma-separated). Empty = allow all (previous behaviour).
# GOSO_WS_ORIGINS=

# MCP (goso-mcp)
# GOSO_GATEWAY_URL=http://localhost:8080
# GOSO_TOKEN=
# GOSO_MCP_PORT=3100

# Optional OTLP (SPEC 042/087). Empty = no export. Do not set Grafana Cloud keys (DI-18).
# Local Jaeger: docker compose --profile otel up -d jaeger
# Host: GOSO_OTEL_ENDPOINT=http://127.0.0.1:4318/v1/traces
# Compose network: GOSO_OTEL_ENDPOINT=http://jaeger:4318/v1/traces
# GOSO_OTEL_ENDPOINT=

# Production overlay (compose.prod.yml)
# GOSO_ENV=production
# BACKUP_INTERVAL_SECONDS=3600
