# Copy to .env and fill in. Used by docker compose (compose.yml / compose.prod.yml).
# Do not commit .env.

GOSO_ENV=development
GOSO_LOG_LEVEL=info
GOSO_ADMIN_TOKEN=
GOSO_RATE_LIMIT=60

# LLM (optional — empty falls back to echo provider)
GOSO_ANTHROPIC_API_KEY=
GOSO_OPENAI_API_KEY=

# Channels (optional)
GOSO_TELEGRAM_BOT_TOKEN=
GOSO_ZALO_OA_ACCESS_TOKEN=
GOSO_ZALO_PERSONAL_TOKEN=

# Production overlay (compose.prod.yml)
# GOSO_ENV=production
# BACKUP_INTERVAL_SECONDS=3600
