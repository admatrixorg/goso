# Copy to .env (gitignored) and fill locally. Never commit real values.

GOSO_PORT=8080
GOSO_LOG_LEVEL=info
GOSO_ENV=development

# Empty = dev mode (no auth). Set a long random token before any public bind.
GOSO_ADMIN_TOKEN=

# Requests per minute per IP. 0 = off.
GOSO_RATE_LIMIT=60

# Empty or :memory: = in-memory. File path = SQLite (e.g. data/goso.db).
GOSO_DB_PATH=

# LLM (optional; unset → echo provider)
GOSO_ANTHROPIC_API_KEY=
GOSO_ANTHROPIC_MODEL=
GOSO_OPENAI_API_KEY=
GOSO_OPENAI_MODEL=

# Channels (optional)
GOSO_TELEGRAM_BOT_TOKEN=
GOSO_ZALO_OA_ACCESS_TOKEN=
GOSO_ZALO_PERSONAL_TOKEN=
