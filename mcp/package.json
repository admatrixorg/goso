{
  "name": "goso-mcp",
  "version": "0.1.0",
  "description": "MCP server for GOSO Gateway management (rebrand of goclaw-mcp, 66 tools, dual transport)",
  "type": "module",
  "bin": {
    "goso-mcp": "./dist/index.js",
    "goso-mcp-http": "./dist/http.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "tsc --noEmit && vitest run && tsup"
  },
  "keywords": [
    "mcp",
    "goso",
    "ai-gateway",
    "model-context-protocol"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
